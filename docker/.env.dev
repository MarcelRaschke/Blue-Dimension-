# Blue Dimension - Development Docker Environment

# App Configuration
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=UTC

# Database
DB_DRIVER=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=jessejay
DB_USERNAME=app
DB_PASSWORD=docker_dev_password

# PHP-FPM
PHP_FPM_PM=dynamic
PHP_FPM_PM_MAX_CHILDREN=20
PHP_FPM_PM_START_SERVERS=5
PHP_FPM_PM_MIN_SPARE_SERVERS=2
PHP_FPM_PM_MAX_SPARE_SERVERS=8

# Nginx
NGINX_HOST=localhost
NGINX_PORT=80

# Site Configuration
SITE_NAME="Blue Dimension - DJ Jesse Jay (Dev)"
SITE_URL=http://localhost:8000
ADMIN_EMAIL=admin@localhost

# IPFS Configuration (optional for dev)
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
IPFS_API_URL=http://ipfs:5001

# Mail Configuration (local dev)
MAIL_DRIVER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@localhost

# Analytics (disabled in dev)
ANALYTICS_ENABLED=false

# Security (relaxed for dev)
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Redis Cache (optional)
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Logging
LOG_LEVEL=debug
LOG_CHANNEL=stack

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Cache
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
