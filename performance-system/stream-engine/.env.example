# Stream Engine Configuration

# Server
PORT=5001
NODE_ENV=production
LOG_LEVEL=info

# Audio Input
AUDIO_INPUT=hw:0

# Audio Encoding
BITRATE=256k
SAMPLE_RATE=44100

# Icecast Configuration
ICECAST_HOST=icecast
ICECAST_PORT=8000
ICECAST_SOURCE_PASSWORD=changeme
ICECAST_ADMIN_PASSWORD=changeme

# Streaming Output
ICECAST_URL=icecast://source:changeme@icecast:8000/blue-dimension

# Archive Configuration
ARCHIVE_PATH=/var/lib/blue-dimension/archive
ARCHIVE_FORMAT=mp3

# Performance
MAX_CONNECTIONS=100
TIMEOUT=30000
