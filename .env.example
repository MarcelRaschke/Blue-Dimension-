# Application Environment
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC

# Website Configuration
SITE_NAME="Blue Dimension - DJ Jesse Jay"
SITE_URL=https://djjessejay.ch
ADMIN_EMAIL=admin@djjessejay.ch

# DJ/Radio Show Configuration
RADIO_STREAM_URL=https://radio-lora.ch/stream
PROGRAM_TITLE="Blue Dimension"
PROGRAM_DAY="Thursday"
PROGRAM_TIME="00:00-06:00"
PROGRAM_TIMEZONE="Europe/Zurich"

# IPFS Configuration (optional)
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
IPFS_API_URL=http://localhost:5001
IPFS_PINNING_SERVICE=pinata

# NFT/Smart Contract Configuration (optional)
WEB3_PROVIDER=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NETWORK_ID=1

# Mail Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@djjessejay.ch

# Analytics (optional)
ANALYTICS_ENABLED=true
ANALYTICS_TRACKING_ID=

# Security
CORS_ALLOWED_ORIGINS=https://djjessejay.ch
API_RATE_LIMIT=100

# ==================== Docker Compose Stack Configuration ====================

# Environment
NODE_ENV=production
LOG_LEVEL=info

# ==================== Icecast Streaming Server ====================
ICECAST_SOURCE_PASSWORD=changeme
ICECAST_RELAY_PASSWORD=changeme
ICECAST_ADMIN_PASSWORD=changeme
ICECAST_HOSTNAME=localhost

# ==================== Stream Engine (Audio Processing) ====================
AUDIO_INPUT=hw:0
BITRATE=256k
SAMPLE_RATE=44100

# ==================== OSC Bridge (CDJ Synchronization) ====================
# For local development: host.docker.internal:11000
# For Ableton on same machine: host.docker.internal:11000
# For remote Ableton: your.ableton.host:11000
ABLETON_OSC_ADDR=host.docker.internal:11000

# ==================== API Server Configuration ====================
STREAM_ENGINE_URL=http://stream-engine:5001

# ==================== Web Dashboard Configuration ====================
NGINX_HOST=localhost
NGINX_PORT=3000

# ==================== Network Configuration ====================
DOMAIN=djjessejay.ch
HTTPS_ENABLED=false
SSL_CERT_PATH=/etc/letsencrypt/live/djjessejay.ch/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/djjessejay.ch/privkey.pem

# ==================== Backup & Archive Configuration ====================
ARCHIVE_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 3 * * 0

# ==================== Monitoring Configuration ====================
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30
ALERT_EMAIL=admin@djjessejay.ch
